# Провайдер LLM: cloudru | gigachat | yandex | minimax | openrouter | openai | mock
LLM_PROVIDER=cloudru
LLM_API_KEY=your_api_key_here
LLM_MODEL=GigaChat/GigaChat-3-Pro
LLM_FALLBACK_MODEL=ai-sage/GigaChat3-10B-A1.8B
# Для openai / openrouter / minimax / локального шлюза:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Для YandexGPT:
# LLM_FOLDER_ID=your_folder_id
# Для прямого GigaChat (Sberbank OAuth):
# GIGACHAT_SCOPE=GIGACHAT_API_B2B
# LLM_CA_BUNDLE=/path/to/russian_trusted_root_ca.cer

# Эмбеддинги (опционально, для векторного поиска; без ключа работает BM25)
EMBED_MODEL=ai-sage/Giga-Embeddings-instruct-480M

# Цифровой аватар (HeyGen API v2 — по умолчанию dry-run, кредиты не расходуются)
HEYGEN_DRY_RUN=true
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=Anna_public_3_20240108
HEYGEN_VOICE_ID=ru-RU-SvetlanaNeural

# Telegram-адаптер (опционально)
TELEGRAM_BOT_TOKEN=
APP_PORT=8091

# Open Weights модель (Apache 2.0) через Cloud.ru FM: gpt-oss-120b, рассуждающая — токены рассуждения входят в max_tokens
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_PRICE_IN_RUB_1M=15.86
# LLM_PRICE_OUT_RUB_1M=61
# LLM_REASONING_EFFORT=low        # low|medium|high, пусто — не передавать
# LLM_MAX_TOKENS_EXTRA=600        # запас токенов на рассуждение
